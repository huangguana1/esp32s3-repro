menu "Reproduction configuration (Path B rogue-AP)"

config REPRO_RUN_DEMO
    bool "Non-interactive demo mode"
    default n
    help
        If enabled, use the SSID configured below instead of asking on the
        serial console. Only use with an AP you own.

config REPRO_TARGET_SSID
    string "Target SSID for demo mode (YOUR OWN router)"
    default ""
    help
        Exact SSID of an access point you own or are authorised to test.

config REPRO_DEMO_SECONDS
    int "Seconds to run the clone AP"
    default 30
    range 5 300

endmenu
